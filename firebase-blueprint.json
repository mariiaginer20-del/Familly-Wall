{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated Google user profile and active family unit reference.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string", "description": "Display name" },
        "email": { "type": "string", "description": "Optional email address" },
        "familyId": { "type": "string", "description": "Optional active FamilyUnit document ID" },
        "avatarEmoji": { "type": "string", "description": "Avatar emoji" },
        "colorHex": { "type": "string", "description": "Hex accent color" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp" }
      },
      "required": ["uid", "displayName", "avatarEmoji", "colorHex", "createdAt", "updatedAt"]
    },
    "InviteCode": {
      "title": "InviteCode",
      "description": "Direct lookup mapping from 6-char uppercase family invite code to familyId.",
      "type": "object",
      "properties": {
        "familyId": { "type": "string" },
        "familyName": { "type": "string" },
        "ownerUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["familyId", "familyName", "ownerUid", "createdAt"]
    },
    "FamilyUnit": {
      "title": "FamilyUnit",
      "description": "Shared family household container holding invite code and member UIDs.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "inviteCode": { "type": "string" },
        "ownerUid": { "type": "string" },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "inviteCode", "ownerUid", "memberUids", "createdAt", "updatedAt"]
    },
    "FamilyMember": {
      "title": "FamilyMember",
      "description": "Family member profile (account-linked or dependent child/member).",
      "type": "object",
      "properties": {
        "familyId": { "type": "string" },
        "linkedUid": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "avatarEmoji": { "type": "string" },
        "colorHex": { "type": "string" },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["familyId", "name", "role", "avatarEmoji", "colorHex", "memberUids", "createdAt", "updatedAt"]
    },
    "ShoppingItem": {
      "title": "ShoppingItem",
      "description": "Grocery list item with supermarket, quantity, priority, and offer notes.",
      "type": "object",
      "properties": {
        "familyId": { "type": "string" },
        "name": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "supermarket": { "type": "string" },
        "priority": { "type": "string", "enum": ["NORMAL", "URGENTE", "CLUB"] },
        "hasOffer": { "type": "boolean" },
        "offerDetails": { "type": "string" },
        "category": { "type": "string" },
        "checked": { "type": "boolean" },
        "addedByMemberName": { "type": "string" },
        "assignedMemberName": { "type": "string" },
        "notes": { "type": "string" },
        "createdByUid": { "type": "string" },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["familyId", "name", "quantity", "unit", "supermarket", "priority", "hasOffer", "offerDetails", "category", "checked", "addedByMemberName", "notes", "createdByUid", "memberUids", "createdAt", "updatedAt"]
    },
    "CustomList": {
      "title": "CustomList",
      "description": "General-purpose shared list (packing, pharmacy, home repairs, etc.).",
      "type": "object",
      "properties": {
        "familyId": { "type": "string" },
        "title": { "type": "string" },
        "emoji": { "type": "string" },
        "colorHex": { "type": "string" },
        "createdByUid": { "type": "string" },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["familyId", "title", "emoji", "colorHex", "createdByUid", "memberUids", "createdAt", "updatedAt"]
    },
    "CustomListItem": {
      "title": "CustomListItem",
      "description": "Item belonging to a general-purpose CustomList.",
      "type": "object",
      "properties": {
        "familyId": { "type": "string" },
        "listId": { "type": "string" },
        "title": { "type": "string" },
        "quantity": { "type": "string" },
        "notes": { "type": "string" },
        "assignedMemberName": { "type": "string" },
        "checked": { "type": "boolean" },
        "createdByUid": { "type": "string" },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["familyId", "listId", "title", "quantity", "notes", "assignedMemberName", "checked", "createdByUid", "memberUids", "createdAt", "updatedAt"]
    },
    "CalendarEvent": {
      "title": "CalendarEvent",
      "description": "Shared family calendar event with date, time range, member assignment, and reminder.",
      "type": "object",
      "properties": {
        "familyId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "location": { "type": "string" },
        "dateEpochMillis": { "type": "integer" },
        "endDateEpochMillis": { "type": "integer" },
        "extraDatesEpochMillis": { "type": "array" },
        "allDay": { "type": "boolean" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "assignedMemberName": { "type": "string" },
        "memberColorHex": { "type": "string" },
        "category": { "type": "string" },
        "reminderMinutesBefore": { "type": "integer" },
        "reminderMinutesList": { "type": "array" },
        "notified": { "type": "boolean" },
        "createdByUid": { "type": "string" },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["familyId", "title", "description", "location", "dateEpochMillis", "startTime", "endTime", "assignedMemberName", "memberColorHex", "category", "reminderMinutesBefore", "notified", "createdByUid", "memberUids", "createdAt", "updatedAt"]
    },
    "FamilyTask": {
      "title": "FamilyTask",
      "description": "Shared household task assigned to a family member.",
      "type": "object",
      "properties": {
        "familyId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "assignedMemberName": { "type": "string" },
        "assignedMemberEmoji": { "type": "string" },
        "dueDate": { "type": "string" },
        "priority": { "type": "string", "enum": ["ALTA", "MEDIA", "BAJA"] },
        "completed": { "type": "boolean" },
        "category": { "type": "string" },
        "createdByUid": { "type": "string" },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["familyId", "title", "description", "assignedMemberName", "assignedMemberEmoji", "dueDate", "priority", "completed", "category", "createdByUid", "memberUids", "createdAt", "updatedAt"]
    },
    "MealPlan": {
      "title": "MealPlan",
      "description": "Weekly meal planner slot for a day index (0..6) and meal type.",
      "type": "object",
      "properties": {
        "familyId": { "type": "string" },
        "dayOfWeekIndex": { "type": "integer" },
        "mealType": { "type": "string", "enum": ["DESAYUNO", "COMIDA", "MERIENDA", "CENA"] },
        "dishName": { "type": "string" },
        "recipeId": { "type": "string" },
        "notes": { "type": "string" },
        "createdByUid": { "type": "string" },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["familyId", "dayOfWeekIndex", "mealType", "dishName", "notes", "createdByUid", "memberUids", "createdAt", "updatedAt"]
    },
    "Recipe": {
      "title": "Recipe",
      "description": "Shared family recipe with ingredients, preparation steps, and favorite flag.",
      "type": "object",
      "properties": {
        "familyId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "prepTimeMinutes": { "type": "integer" },
        "servings": { "type": "integer" },
        "ingredients": { "type": "string" },
        "instructions": { "type": "string" },
        "emoji": { "type": "string" },
        "favorite": { "type": "boolean" },
        "createdByUid": { "type": "string" },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["familyId", "title", "category", "prepTimeMinutes", "servings", "ingredients", "instructions", "emoji", "favorite", "createdByUid", "memberUids", "createdAt", "updatedAt"]
    },
    "FamilyCategory": {
      "title": "FamilyCategory",
      "description": "Editable per-family category for events, tasks, shopping, or recipes.",
      "type": "object",
      "properties": {
        "familyId": { "type": "string" },
        "scope": { "type": "string", "enum": ["EVENT", "TASK", "SHOPPING", "RECIPE"] },
        "name": { "type": "string" },
        "emoji": { "type": "string" },
        "colorHex": { "type": "string" },
        "createdByUid": { "type": "string" },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["familyId", "scope", "name", "emoji", "colorHex", "createdByUid", "memberUids", "createdAt", "updatedAt"]
    },
    "ProductHistoryEntry": {
      "title": "ProductHistoryEntry",
      "description": "Shared autocomplete history for previously entered shopping items.",
      "type": "object",
      "properties": {
        "familyId": { "type": "string" },
        "name": { "type": "string" },
        "nameLower": { "type": "string" },
        "lastUnit": { "type": "string" },
        "lastCategory": { "type": "string" },
        "lastSupermarket": { "type": "string" },
        "useCount": { "type": "integer" },
        "createdByUid": { "type": "string" },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["familyId", "name", "nameLower", "lastUnit", "lastCategory", "lastSupermarket", "useCount", "createdByUid", "memberUids", "createdAt", "updatedAt"]
    },
    "PetFeedingStatus": {
      "title": "PetFeedingStatus",
      "description": "Shared daily pet feeding tracker status (e.g., whether Oliva has been fed today).",
      "type": "object",
      "properties": {
        "familyId": { "type": "string" },
        "petName": { "type": "string" },
        "dateKey": { "type": "string" },
        "fed": { "type": "boolean" },
        "fedByMemberName": { "type": "string" },
        "fedTimeLabel": { "type": "string" },
        "createdByUid": { "type": "string" },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["familyId", "petName", "dateKey", "fed", "fedByMemberName", "fedTimeLabel", "createdByUid", "memberUids", "createdAt", "updatedAt"]
    },
    "MacroTargets": {
      "title": "MacroTargets",
      "description": "Predefined daily and per-meal (Desayuno, Comida, Cena) carbohydrate, protein, and fat targets in grams.",
      "type": "object",
      "properties": {
        "familyId": { "type": "string" },
        "dailyCarbsG": { "type": "number" },
        "dailyProteinG": { "type": "number" },
        "dailyFatG": { "type": "number" },
        "breakfastCarbsG": { "type": "number" },
        "breakfastProteinG": { "type": "number" },
        "breakfastFatG": { "type": "number" },
        "lunchCarbsG": { "type": "number" },
        "lunchProteinG": { "type": "number" },
        "lunchFatG": { "type": "number" },
        "dinnerCarbsG": { "type": "number" },
        "dinnerProteinG": { "type": "number" },
        "dinnerFatG": { "type": "number" },
        "createdByUid": { "type": "string" },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["familyId", "dailyCarbsG", "dailyProteinG", "dailyFatG", "breakfastCarbsG", "breakfastProteinG", "breakfastFatG", "lunchCarbsG", "lunchProteinG", "lunchFatG", "dinnerCarbsG", "dinnerProteinG", "dinnerFatG", "createdByUid", "memberUids", "createdAt", "updatedAt"]
    },
    "MacroIngredient": {
      "title": "MacroIngredient",
      "description": "Ingredient nutritional macro profile per 100g for automatic meal gram calculation.",
      "type": "object",
      "properties": {
        "familyId": { "type": "string" },
        "name": { "type": "string" },
        "emoji": { "type": "string" },
        "carbsPer100g": { "type": "number" },
        "proteinPer100g": { "type": "number" },
        "fatPer100g": { "type": "number" },
        "createdByUid": { "type": "string" },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["familyId", "name", "emoji", "carbsPer100g", "proteinPer100g", "fatPer100g", "createdByUid", "memberUids", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Authenticated user profile and active family link."
    },
    "/inviteCodes/{code}": {
      "schema": { "$ref": "#/entities/InviteCode" },
      "description": "Lookup index from invite code to family unit."
    },
    "/families/{familyId}": {
      "schema": { "$ref": "#/entities/FamilyUnit" },
      "description": "Family household unit metadata and member UID allowlist."
    },
    "/families/{familyId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/FamilyMember" },
      "description": "Family members (account holders and dependents)."
    },
    "/families/{familyId}/shoppingItems/{itemId}": {
      "schema": { "$ref": "#/entities/ShoppingItem" },
      "description": "Shared family shopping list items."
    },
    "/families/{familyId}/customLists/{listId}": {
      "schema": { "$ref": "#/entities/CustomList" },
      "description": "General-purpose shared family lists."
    },
    "/families/{familyId}/customListItems/{itemId}": {
      "schema": { "$ref": "#/entities/CustomListItem" },
      "description": "Items belonging to general-purpose shared lists."
    },
    "/families/{familyId}/calendarEvents/{eventId}": {
      "schema": { "$ref": "#/entities/CalendarEvent" },
      "description": "Shared family calendar events."
    },
    "/families/{familyId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/FamilyTask" },
      "description": "Shared family tasks."
    },
    "/families/{familyId}/mealPlans/{mealPlanId}": {
      "schema": { "$ref": "#/entities/MealPlan" },
      "description": "Biweekly family meal plans."
    },
    "/families/{familyId}/recipes/{recipeId}": {
      "schema": { "$ref": "#/entities/Recipe" },
      "description": "Shared family recipe book."
    },
    "/families/{familyId}/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/FamilyCategory" },
      "description": "Editable categories per module scope."
    },
    "/families/{familyId}/productHistory/{entryId}": {
      "schema": { "$ref": "#/entities/ProductHistoryEntry" },
      "description": "Autocomplete shopping product history."
    },
    "/families/{familyId}/petCare/{entryId}": {
      "schema": { "$ref": "#/entities/PetFeedingStatus" },
      "description": "Daily pet feeding check status synced across family members."
    },
    "/families/{familyId}/macroTargets/{targetId}": {
      "schema": { "$ref": "#/entities/MacroTargets" },
      "description": "Daily and per-meal macro gram targets."
    },
    "/families/{familyId}/macroIngredients/{ingredientId}": {
      "schema": { "$ref": "#/entities/MacroIngredient" },
      "description": "Customizable ingredients with carbs, protein, and fat per 100g."
    }
  }
}
